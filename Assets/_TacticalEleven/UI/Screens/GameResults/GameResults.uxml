<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="GameResults.uss" />
    <ui:VisualElement name="GameResultsRoot" class="gresults-root">

        <ui:VisualElement class="gresults-main">
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement class="header-left">
                    <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                    <ui:VisualElement class="header-team-info">
                        <ui:VisualElement class="header-team-name-row">
                            <ui:Label name="HeaderTeamName" text="" class="header-team-name"/>
                            <ui:Label name="HeaderSubtitle" text="{loc:ui.game_results.header_subtitle}" class="header-subtitle"/>
                        </ui:VisualElement>
                        <ui:Label name="HeaderManagerName" text="" class="header-manager-name"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="header-right-group">
                    <ui:VisualElement class="header-season-info">
                        <ui:Label name="HeaderSeason" text="" class="header-season-label"/>
                    </ui:VisualElement>
                    <ui:Label name="HeaderDate" text="" class="header-date-label"/>
                    <ui:Label name="HeaderGameDay" text="" class="header-game-day-label"/>
                    <ui:VisualElement name="LoadingSpinner" class="loading-spinner" />
                    <ui:Button name="BtnDashboard" text="{loc:ui.game_results.btn_dashboard}" class="btn-action"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView horizontal-scrolling-enabled="false" mode="Vertical" class="gresults-scroll">
                <ui:VisualElement class="gresults-content">
                    <ui:VisualElement class="gresults-layout">
                        <ui:VisualElement class="gresults-left">
                            <ui:VisualElement class="gresults-section-header">
                                <ui:Label text="{loc:ui.game_results.resultados}" class="gresults-section-title"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="GamesBody" class="games-body"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="gresults-right">
                            <ui:VisualElement name="MvpPanel" class="mvp-panel">
                                <ui:VisualElement class="mvp-badge">
                                    <ui:Label text="{loc:ui.game_results.mvp_del_partido}" class="mvp-badge-text"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="mvp-content">
                                    <ui:VisualElement class="mvp-player-info">
                                        <ui:VisualElement name="MvpLogo" class="mvp-team-logo"/>
                                        <ui:VisualElement class="mvp-player-details">
                                            <ui:Label name="MvpName" text="{loc:ui.game_results.mvp_name}" class="mvp-player-name"/>
                                            <ui:Label name="MvpTeam" text="{loc:ui.game_results.mvp_team}" class="mvp-player-team"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mvp-stats">
                                        <ui:VisualElement class="mvp-stat mvp-rating">
                                            <ui:Label name="MvpVal" text="0" class="mvp-stat-val"/>
                                            <ui:Label text="{loc:ui.game_results.nota}" class="mvp-stat-label"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="Leaderboards" class="leaderboards">
                                <ui:VisualElement name="LbScorers" class="leaderboard-section" style="margin-bottom: 10px;">
                                    <ui:Label text="{loc:ui.game_results.maximos_goleadores}" class="leaderboard-title"/>
                                    <ui:VisualElement name="LbScorersBody" class="leaderboard-body"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="LbAssisters" class="leaderboard-section" style="margin-bottom: 10px;">
                                    <ui:Label text="{loc:ui.game_results.maximos_asistentes}" class="leaderboard-title"/>
                                    <ui:VisualElement name="LbAssistersBody" class="leaderboard-body"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="LbRated" class="leaderboard-section">
                                    <ui:Label text="{loc:ui.game_results.mejores_notas}" class="leaderboard-title"/>
                                    <ui:VisualElement name="LbRatedBody" class="leaderboard-body"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
